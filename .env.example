# All runtime configuration comes from the environment (12-factor). No TBC value is hard-coded.
NSRDP_DATABASE_URL=postgresql+psycopg://nsrdp:nsrdp@localhost:5432/nsrdp
NSRDP_CONFIG_DIR=config
NSRDP_ENVIRONMENT=local
# dev = trust X-NSRDP-Principal / X-NSRDP-Tenant headers (local only). Identity provider is TBC.
NSRDP_AUTH_MODE=disabled
